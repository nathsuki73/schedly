{
  "name": "schedly",
  "version": "1.0.0",
  "description": "AI-powered Discord bot that turns event links into Discord scheduled events",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --include-runtime false",
    "register": "node --env-file=.dev.vars scripts/register-commands.ts",
    "db:migrate:local": "wrangler d1 migrations apply schedly --local",
    "db:migrate:remote": "wrangler d1 migrations apply schedly --remote"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
