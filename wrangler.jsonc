{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schedly",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schedly",
      "database_id": "ec585ae0-e305-428f-b532-e21b3a5f1a8d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FALLBACK_MODELS": "gemini-3.6-flash,gemini-flash-latest"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, or `.dev.vars` locally):
  //   DISCORD_APPLICATION_ID, DISCORD_PUBLIC_KEY, DISCORD_BOT_TOKEN, GEMINI_API_KEY
}
